# --- serial (check the real COM number in Device Manager)
COM_PORT=COM5
BAUDRATE=9600
MODBUS_TIMEOUT=0.8
POLL_INTERVAL=1.0
TELEMETRY_INTERVAL=2.0
# AUTO control ignores a sensor value older than this many seconds
SENSOR_STALE_SECONDS=20
# After a failed relay write, AUTO control waits this many seconds before retrying
RELAY_RETRY_SECONDS=10

# --- web link (must match GATEWAY_TOKEN in the root .env)
WEB_WS_URL=ws://127.0.0.1:8000/ws/gateway
GATEWAY_TOKEN=change-me

# --- Modbus addresses: TH10S-B-PE = 1, SEN0644 = 2, Relay = 3 (see gateway/README.md)
SHT30_ID=1
LIGHT_ID=2
RELAY_ID=3

# --- TH10S-B-PE register map: UNVERIFIED. Run gateway/tools/probe_modbus.py, then fix these.
TH_FUNCTION=3
TH_TEMP_REG=1
TH_HUM_REG=0
TH_SCALE=10

# --- relay wiring and AUTO thresholds
FAN_CHANNEL=0
LED_CHANNEL=1
FAN_ON_TEMP=30.0
FAN_OFF_TEMP=27.0
LED_ON_LUX=3000
LED_OFF_LUX=5000
